# Kopieren nach ".env" und Werte anpassen, bevor "docker compose up" ausgeführt wird.

# Geheimnis zum Signieren der Session-Cookies — in Produktion unbedingt ein
# langes, zufälliges Secret setzen (z. B. `openssl rand -hex 32`).
SESSION_SECRET=bitte-unbedingt-aendern

# Initiales Admin-Konto, wird nur beim allerersten Start angelegt (wenn noch
# keine Benutzer existieren).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Auf true setzen, wenn die App hinter einem HTTPS-Reverse-Proxy läuft.
COOKIE_SECURE=false
TRUST_PROXY=false
